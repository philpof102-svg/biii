.env
node_modules/
out/
data/*

# known-bad.json is a small PUBLIC seed the decentralized screen needs at runtime — track it (the rest of data/ stays ignored: generated/large artifacts)
!data/known-bad.json
# issuer-verified.json is the small, curated, ISSUER-OFFICIAL registry (on-chain-verified addresses) — ships so /asset can show the green "issuer-verified" without the non-commercial Coingecko file.
!data/issuer-verified.json
dist/

# Hermes agent cron output (generated per-run)
hermes/agents/*/cache/

# x402 anti-replay runtime store (not source)
data/x402-consumed.json
