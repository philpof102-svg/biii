# BIII — environment. Copy to .env for local dev; set these in your host (Railway → Variables) for prod.

# REQUIRED. The merchant's OWN Base wallet address (0x…40hex). NON-CUSTODIAL: BIII holds no key and moves
# no funds — the customer pays THIS address directly. One merchant per deploy (the server pins it, so a
# caller can never redirect a charge/verdict/receipt to another address).
BIII_MERCHANT=0xYourBaseWalletAddressHere

# OPTIONAL. Base RPC endpoint for reading the chain (verifying payments). Defaults to the public
# https://mainnet.base.org — fine for a low-volume till. Set a dedicated RPC (Alchemy/Infura/CDP) to avoid
# public-node rate limits under load. Read-only; never a private key.
# BASE_RPC_URL=https://mainnet.base.org

# OPTIONAL. Port to bind. Most PaaS (Railway) inject PORT automatically; leave unset there. Local default 4700.
# PORT=4700
BIII_ROUTER_ENABLED=false
